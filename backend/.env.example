PORT=3001
DATABASE_URL="file:./dev.db"

# 64-char hex. If unset, auto-generated on first boot and saved to .cred-key.
CRED_ENCRYPTION_KEY=

# WordPress credentials (optional — can also be set via Settings UI)
WP_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Source
SOURCE_URL=https://www.gamigion.com/

# Scheduler
SCRAPE_CRON=0 * * * *
SCRAPE_CRON_ENABLED=true

# --- Production-only ---
# Public origin of THIS backend, e.g. https://your-backend.up.railway.app
# WordPress fetches generated images from this URL during publish — must be reachable from the WP host.
PUBLIC_BASE_URL=

# Restrict CORS to a single origin in prod, e.g. https://your-frontend.vercel.app
# Leave unset in dev (defaults to allow all).
CORS_ORIGIN=
